-- JSON (S3): jsonParse reads a Text into the domain Json tree or gives the
-- error text with its byte offset; jsonRender writes the tree with no
-- spaces. An integer that fits Int64 is jnum (inl n), any other number is
-- jnum (inr text). The round trip is a Path. The entry renders a number
-- text and gives its length.
def doc : Sum Text Json := jsonParse "{\"id\": 7, \"tags\": [\"a\", true, null], \"ratio\": 1.5}"
def parseError : Sum Text Json := jsonParse "[1,"
def rendered : Text := jsonRender (jobj (jfCons "id" (jnum (inl 7)) (jfCons "ok" (jbool true) jfNil)))
def escaped : Text := jsonRender (jstr "a\"b\x01")
def roundTrip : Path (Sum Text Json) (jsonParse (jsonRender (jarr (jlCons (jnum (inl 1)) (jlCons jnull jlNil))))) (inr (jarr (jlCons (jnum (inl 1)) (jlCons jnull jlNil)))) := refl
def renderedLength : (n : Nat) -> Nat := fun (n : Nat) => textLength (jsonRender (jarr (jlCons (jnum (inr (natShow n))) jlNil)))
def maxNumber : Sum Text Json := jsonParse "9223372036854775807"
def overNumber : Sum Text Json := jsonParse "9223372036854775808"
def minNumber : Sum Text Json := jsonParse "-9223372036854775808"
def underNumber : Sum Text Json := jsonParse "-9223372036854775809"
