-- Model responses (S7). Each def is a closed function over a response
-- value of ollama, at a sample value in the form that the driver gives:
-- inr of the array of the response objects (one object at "stream": false,
-- one object for each NDJSON line of a stream), or inl of the text
-- ollama: URL: TEXT. No IO runs: the gate evaluates each def. itemsOf,
-- fieldOf and textOf are the folds of examples/fs.lang. boolOf gives the
-- Bool of a jbool.
def noJson : List Json := nil
def noBool : Option Bool := none
def itemsOf : Json -> List Json :=
  fun (j : Json) => second (fold (Prod Json (List Json)) (Prod JsonList (List Json)) JsonFields
    (pair jnull noJson) (fun (b : Bool) => pair (jbool b) noJson) (fun (n : Sum Int64 Text) => pair (jnum n) noJson) (fun (t : Text) => pair (jstr t) noJson)
    (fun (l : Prod JsonList (List Json)) => pair (jarr (first l)) (second l)) (fun (f : JsonFields) => pair (jobj f) noJson)
    (pair jlNil noJson) (fun (h : Prod Json (List Json)) (t : Prod JsonList (List Json)) => pair (jlCons (first h) (first t)) (cons (first h) (second t)))
    jfNil (fun (k : Text) (v : Prod Json (List Json)) (t : JsonFields) => jfCons k (first v) t) j)
def fieldOf : Text -> Json -> Json :=
  fun (k : Text) (j : Json) => second (fold (Prod Json Json) JsonList (Prod JsonFields Json)
    (pair jnull jnull) (fun (b : Bool) => pair (jbool b) jnull) (fun (n : Sum Int64 Text) => pair (jnum n) jnull) (fun (t : Text) => pair (jstr t) jnull)
    (fun (l : JsonList) => pair (jarr l) jnull) (fun (f : Prod JsonFields Json) => pair (jobj (first f)) (second f))
    jlNil (fun (h : Prod Json Json) (t : JsonList) => jlCons (first h) t)
    (pair jfNil jnull) (fun (key : Text) (v : Prod Json Json) (t : Prod JsonFields Json) => pair (jfCons key (first v) (first t)) (boolIf Json (textEq key k) (first v) (second t))) j)
def textOf : Json -> Text :=
  fun (j : Json) => fold Text Unit Unit "" (fun (b : Bool) => "") (fun (n : Sum Int64 Text) => "") (fun (t : Text) => t) (fun (l : Unit) => "") (fun (f : Unit) => "")
    unit (fun (h : Text) (t : Unit) => unit) unit (fun (k : Text) (v : Text) (t : Unit) => unit) j
def boolOf : Json -> Option Bool :=
  fun (j : Json) => fold (Option Bool) Unit Unit noBool (fun (b : Bool) => some b) (fun (n : Sum Int64 Text) => noBool) (fun (t : Text) => noBool) (fun (l : Unit) => noBool) (fun (f : Unit) => noBool)
    unit (fun (h : Option Bool) (t : Unit) => unit) unit (fun (k : Text) (v : Option Bool) (t : Unit) => unit) j
-- joined gives the response texts of a stream, in the stream order, as one
-- text. content gives the message.content of the first object (a chat).
-- lastDone gives the done of the last object that has a done. Each gives
-- "" (none for lastDone) at an inl response.
def joined : Sum Text Json -> Text :=
  fun (r : Sum Text Json) => either (fun (e : Text) => "") (fun (j : Json) => fold (fun (x : Json) (rest : Text) => textAppend (textOf (fieldOf "response" x)) rest) "" (itemsOf j)) r
def content : Sum Text Json -> Text :=
  fun (r : Sum Text Json) => either (fun (e : Text) => "") (fun (j : Json) => fold (fun (x : Json) (rest : Text) => textOf (fieldOf "content" (fieldOf "message" x))) "" (itemsOf j)) r
def lastDone : Sum Text Json -> Option Bool :=
  fun (r : Sum Text Json) => either (fun (e : Text) => noBool) (fun (j : Json) => fold (fun (x : Json) (rest : Option Bool) => option (boolOf (fieldOf "done" x)) (fun (b : Bool) => some b) rest) noBool (itemsOf j)) r
-- The sample responses:  a generate stream of 3 objects, a chat at
-- "stream": false and a refused connect.
def stream : Sum Text Json :=
  inr (jarr (jlCons (jobj (jfCons "model" (jstr "m") (jfCons "response" (jstr "Hel") (jfCons "done" (jbool false) jfNil))))
    (jlCons (jobj (jfCons "model" (jstr "m") (jfCons "response" (jstr "lo") (jfCons "done" (jbool false) jfNil))))
    (jlCons (jobj (jfCons "model" (jstr "m") (jfCons "response" (jstr "") (jfCons "done" (jbool true) (jfCons "total_duration" (jnum (inl 10706818083)) jfNil))))) jlNil))))
def chat : Sum Text Json :=
  inr (jarr (jlCons (jobj (jfCons "model" (jstr "m") (jfCons "message" (jobj (jfCons "role" (jstr "assistant") (jfCons "content" (jstr "hi there") jfNil))) (jfCons "done" (jbool true) jfNil)))) jlNil))
def refused : Sum Text Json := inl "ollama: http://127.0.0.1:1/api/chat: Connection refused"
def streamText : Text := joined stream
def chatText : Text := content chat
def streamDone : Option Bool := lastDone stream
def refusedDone : Option Bool := lastDone refused
