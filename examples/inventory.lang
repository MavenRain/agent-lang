-- The sample domain in use (S3 chunk A): Json records, a Log, Bool tests
-- and a priced vector. Text fields wait for chunk B, which evaluates them.
def bolt : Json := jarr (jlCons (jnum (inl 3)) (jlCons (jnum (inl 10)) jlNil))
def nut : Json := jarr (jlCons (jnum (inl 1)) (jlCons (jnum (inl 40)) jlNil))
def stock : Log := logAppend (logAppend logEmpty bolt) nut
def stockCount : Nat := logLength stock
def lineTotal : (price count : Nat) -> Nat := fun (price count : Nat) => natMul price count
def stockTotal : Nat := natAdd (lineTotal 3 10) (lineTotal 1 40)
def isRed : (c : Fin 3) -> Bool := fun (c : Fin 3) => finCase 3 c true false false
def stockRed : Nat := natAdd (boolIf Nat (isRed 0) (lineTotal 3 10) 0) (boolIf Nat (isRed 2) (lineTotal 1 40) 0)
def pile : List Nat := cons 1 (cons 2 nil)
def pileDepth : Nat := fold (fun (top : Nat) (acc : Nat) => natAdd acc 1) 0 pile
def lot : Sigma (price : Nat) (Vec Nat 1) := pack 250 (vcons Nat 0 250 (vnil Nat))
def lotCost : Nat := witness lot
