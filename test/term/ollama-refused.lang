-- Writes the ollama response of /api/chat at OLLAMA_HOST=127.0.0.1:1 (S7):
-- no listener, thus inl of the connect text. Port 1, never 11434.
def shown : Sum Text Json -> Text := fun (r : Sum Text Json) => either (fun (e : Text) => e) (fun (j : Json) => jsonRender j) r
def main : IO Unit := bind (ollama "/api/chat" (jobj (jfCons "model" (jstr "m") (jfCons "messages" (jarr (jlCons (jobj (jfCons "role" (jstr "user") (jfCons "content" (jstr "hi") jfNil))) jlNil)) (jfCons "stream" (jbool false) jfNil))))) (fun (r : Sum Text Json) => write (textAppend (shown r) "\n"))
